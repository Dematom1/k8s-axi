{
  "name": "k8s-axi",
  "version": "0.1.2",
  "description": "Strictly read-only Kubernetes diagnostics for agents",
  "type": "module",
  "license": "MIT",
  "author": "Laszlo Horanszky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dematom1/k8s-axi.git"
  },
  "homepage": "https://github.com/Dematom1/k8s-axi#readme",
  "bugs": {
    "url": "https://github.com/Dematom1/k8s-axi/issues"
  },
  "keywords": [
    "kubernetes",
    "cli",
    "agent",
    "axi",
    "toon"
  ],
  "bin": {
    "k8s-axi": "./dist/bin/k8s-axi.js",
    "k8s-axi-ctx": "./dist/bin/k8s-axi-ctx.js"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "skills/k8s-axi",
    "LICENSE",
    "README.md",
    "ROADMAP.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin/*.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && node dist/scripts/build-skill.js --check",
    "prepublishOnly": "npm run check",
    "test:real": "npm run build && vitest run test/real-kubectl.test.ts",
    "test:live": "npm run build && K8S_AXI_LAB_LIVE=1 K8S_AXI_LIVE=1 vitest run test/live"
    "build:skill": "npm run build && node dist/scripts/build-skill.js",
    "check:skill": "npm run build && node dist/scripts/build-skill.js --check"
  },
  "dependencies": {
    "@toon-format/toon": "2.3.1",
    "axi-sdk-js": "0.1.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "js-yaml": "4.1.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.5"
  }
}
