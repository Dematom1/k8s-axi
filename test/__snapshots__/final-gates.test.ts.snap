// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`pin every allowed operation 1`] = `
[
  [
    "config",
    "current-context",
  ],
  [
    "config",
    "get-contexts",
    "-o",
    "name",
  ],
  [
    "version",
    "--client",
    "-o",
    "json",
  ],
  [
    "config",
    "view",
    "--minify",
    "--context=default",
    "-o",
    "jsonpath={.clusters[0].cluster.server}{"\\n"}{.contexts[0].context.namespace}",
  ],
  [
    "get",
    "namespace",
    "sandbox",
    "-o",
    "name",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "version",
    "-o",
    "json",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "get",
    "nodes",
    "-o",
    "json",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "get",
    "namespaces",
    "-o",
    "json",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "get",
    "pods",
    "-n",
    "sandbox",
    "-o",
    "json",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "get",
    "deployments.apps",
    "-n",
    "sandbox",
    "-o",
    "json",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "get",
    "jobs.batch",
    "-n",
    "sandbox",
    "-o",
    "json",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "get",
    "persistentvolumeclaims",
    "-n",
    "sandbox",
    "-o",
    "json",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "get",
    "services",
    "-n",
    "sandbox",
    "-o",
    "json",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "get",
    "endpointslices.discovery.k8s.io",
    "-n",
    "sandbox",
    "-o",
    "json",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "get",
    "events",
    "-n",
    "sandbox",
    "-o",
    "json",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "get",
    "events",
    "-n",
    "sandbox",
    "--field-selector=type=Warning,involvedObject.kind=Pod,involvedObject.name=object",
    "-o",
    "json",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "get",
    "node",
    "object",
    "-o",
    "json",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "get",
    "pod",
    "object",
    "-n",
    "sandbox",
    "-o",
    "json",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "get",
    "deployment.apps",
    "object",
    "-n",
    "sandbox",
    "-o",
    "json",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "get",
    "namespace",
    "sandbox",
    "-o",
    "json",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "get",
    "secrets",
    "-A",
    "--output=go-template={{range .items}}{{"["}}{{printf "%q" .metadata.namespace}},{{printf "%q" .metadata.name}},{{printf "%q" (printf "%v" .type)}},{{printf "%q" .metadata.creationTimestamp}},{{"["}}{{$sep := ""}}{{range $k, $_ := .data}}{{$sep}}{{printf "%q" $k}}{{$sep = ","}}{{end}}{{"]]\\n"}}{{end}}",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "get",
    "secrets",
    "-n",
    "sandbox",
    "--field-selector=metadata.name=object",
    "--output=go-template={{range .items}}{{"["}}{{printf "%q" .metadata.namespace}},{{printf "%q" .metadata.name}},{{printf "%q" (printf "%v" .type)}},{{printf "%q" .metadata.creationTimestamp}},{{"["}}{{$sep := ""}}{{range $k, $_ := .data}}{{$sep}}{{printf "%q" $k}}{{$sep = ","}}{{end}}{{"]]\\n"}}{{end}}",
    "--context=default",
    "--request-timeout=15000ms",
  ],
  [
    "logs",
    "object",
    "-n",
    "sandbox",
    "-c",
    "object",
    "--tail=100",
    "--limit-bytes=1048576",
    "--since=60s",
    "--previous",
    "--context=default",
    "--request-timeout=15000ms",
  ],
]
`;
